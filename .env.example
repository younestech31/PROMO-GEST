# PROMO GEST Local ERP Environment Configuration Template
# Copy to .env for local development or configure in appsettings.Production.json for production.

# ConnectionStrings__DefaultConnection: PostgreSQL 18 connection string
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=promogest;Username=promogest_app;Password=CHANGE_ME_IN_LOCAL_CONFIG"

# Storage__RootDirectory: Absolute or relative local directory for document storage
Storage__RootDirectory="./storage"

# Security__RequireHttpsCookies: Set to true in production behind HTTPS reverse proxy (Caddy)
Security__RequireHttpsCookies="true"
