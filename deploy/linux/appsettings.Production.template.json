{
  "Storage": {
    "RootDirectory": "/var/lib/promogest/storage"
  },
  "Security": {
    "RequireHttpsCookies": true,
    "DataProtectionKeyDirectory": "/var/lib/promogest/dataprotection-keys",
    "DataProtectionCertificatePath": "/var/lib/promogest/dataprotection-keys/protection.pfx",
    "AllowedOrigins": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
