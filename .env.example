# PROMO GEST Local ERP Environment Configuration Template
# Copy to .env for local development or configure in appsettings.Production.json for production.

# ConnectionStrings__DefaultConnection: PostgreSQL 18 connection string
ConnectionStrings__DefaultConnection="Host=127.0.0.1;Port=5432;Database=promogest;Username=promogest_app;Password=CHANGE_ME_IN_LOCAL_CONFIG"

# Storage__RootDirectory: Absolute or relative directory for local document storage
Storage__RootDirectory="./storage"

# Security__RequireHttpsCookies: Set to true in production behind HTTPS reverse proxy (Caddy)
Security__RequireHttpsCookies="true"

# Server-enforced session policy. Sessions are revoked after the idle window and after the
# absolute lifetime, whichever comes first. TouchInterval must be shorter than the idle
# window; an inconsistent combination fails at startup instead of at first request.
# Security__SessionAbsoluteLifetimeHours="12"
# Security__SessionIdleTimeoutMinutes="30"   # 5-480 minutes
# Security__SessionTouchIntervalMinutes="1"

# Temporary credential window for forced rotation (employees, administrator resets).
# Security__TemporaryPasswordLifetimeHours="24"

# Login rate limit per client IP: fixed one-minute window. Values outside 1-100 are clamped.
# Security__LoginRateLimitPermitLimit="10"   # 1-100 requests per minute per client IP

# Optional real ASP.NET Core API target for Vite development.
# If this points to loopback, scripts/dev-with-local-api.sh starts (or verifies)
# the local API and refuses to start Vite until /health/ready succeeds.
# ASPNETCORE_URL="http://127.0.0.1:5055"

# Explicit frontend-only simulator mode; never uses the real API or database.
# PROMOGEST_VITE_ONLY="1"

# Google AI Studio Cloud SQL (Development only)
# These values are injected by the AI Studio Cloud SQL integration.
# Never commit actual credentials or add secrets to frontend/VITE_* variables.
# SQL_HOST=
# SQL_DB_NAME=
# SQL_USER=
# SQL_PASSWORD=
# SQL_ADMIN_USER=
# SQL_ADMIN_PASSWORD=
