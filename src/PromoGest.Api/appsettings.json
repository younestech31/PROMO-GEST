{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=promogest;Username=promogest_app;Password=CHANGE_ME_IN_LOCAL_CONFIG"
  },
  "Storage": {
    "RootDirectory": "./storage"
  },
  "Security": {
    "RequireHttpsCookies": true,
    "AllowedOrigins": [],
    "SetupBootstrapToken": "",
    "SessionAbsoluteLifetimeHours": 12,
    "SessionIdleTimeoutMinutes": 30,
    "SessionTouchIntervalMinutes": 1,
    "TemporaryPasswordLifetimeHours": 24
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
