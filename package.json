{
  "name": "promogest-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:cloudsql": "bash scripts/run-ai-studio-cloudsql.sh",
    "build": "vite build",
    "build:aspnetcore": "vite build --config apps/local-web/vite.config.ts --outDir ../../src/PromoGest.Api/wwwroot --emptyOutDir",
    "preview": "vite preview",
    "clean": "rm -rf dist apps/local-web/dist",
    "lint": "tsc -p apps/local-web/tsconfig.json --noEmit",
    "test": "tsx --test apps/local-web/src/utils/*.test.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
