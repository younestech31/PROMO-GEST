# Copy to /etc/promogest/promogest.env; replace both placeholders with independent
# secrets generated with: openssl rand -hex 32
# Keep this file owned by root:promogest and mode 0640.
ConnectionStrings__DefaultConnection=Host=127.0.0.1;Port=5432;Database=promogest;Username=promogest_app;Password=REPLACE_WITH_RUNTIME_DB_SECRET
PROMOGEST_DATA_PROTECTION_CERT_PASSWORD=REPLACE_WITH_DP_CERTIFICATE_SECRET
# Session and temporary-password timing are server-enforced. Override here only when the
# deployment policy differs from the defaults (idle lock 30 min, absolute 12 h, rotation 24 h):
# Security__SessionIdleTimeoutMinutes=30
# Security__SessionAbsoluteLifetimeHours=12
# Security__TemporaryPasswordLifetimeHours=24
# Optional one-time bootstrap secret required via X-PROMOGEST-SETUP-TOKEN when initializing from non-loopback LAN clients:
# PROMOGEST_SETUP_TOKEN=REPLACE_WITH_ONE_TIME_SETUP_TOKEN

