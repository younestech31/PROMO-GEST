{
  "Storage": {
    "RootDirectory": "/var/lib/promogest/storage"
  },
  "Security": {
    "RequireHttpsCookies": true,
    "DataProtectionKeyDirectory": "/var/lib/promogest/dataprotection-keys",
    "DataProtectionCertificatePath": "/var/lib/promogest/dataprotection-keys/protection.pfx",
    "AllowedOrigins": [],
    "SessionAbsoluteLifetimeHours": 12,
    "SessionIdleTimeoutMinutes": 30,
    "SessionTouchIntervalMinutes": 1,
    "TemporaryPasswordLifetimeHours": 24,
    "LoginRateLimitPermitLimit": 10,
    "SetupRateLimitPermitLimit": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
